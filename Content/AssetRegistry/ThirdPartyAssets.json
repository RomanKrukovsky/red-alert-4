      "commercial_use_allowed": true,
      "contains_third_party_ip": false,
      "similarity_review_status": "reviewed",
      "reviewer": "compliance reconciliation 2026-08-06",
      "comment": "951 EVA/unit voice files synthesised in-project from this repository's own line scripts and speaker profiles. Recorded as one covering entry rather than 951 rows: coverage_matches() treats a record path as covering the subtree, and a per-file listing would be unreviewable and would rot on the next regeneration. sha256 is a digest OF THE TREE (each file's relative path plus its content hash, in sorted order), so it is deterministic, it changes when the audio changes, and it does not pretend to be one file's checksum.",
      "release_allowed": true,
      "checksumSHA256": "b3b31e8a00ebb5f3bb66596b6168ff17e5fb53a84ed2c37d30fde6f6da87f4a1"
