  "confusion_matrix": {
    "_comment": "rows[true][observed], each row must sum to exactly 1.0. Light/heavy vehicles are confusable; infantry/aircraft almost never.",
    "rows": {
      "infantry":      { "infantry": 0.97, "light_vehicle": 0.03 },
      "light_vehicle": { "light_vehicle": 0.85, "heavy_vehicle": 0.12, "infantry": 0.03 },
      "heavy_vehicle": { "heavy_vehicle": 0.86, "light_vehicle": 0.13, "structure": 0.01 },
      "aircraft":      { "aircraft": 0.98, "light_vehicle": 0.02 },
      "ship":          { "ship": 0.95, "heavy_vehicle": 0.05 },
      "structure":     { "structure": 0.97, "heavy_vehicle": 0.03 }
    }
  },

  "track_tuning": {
    "confidence_decay_per_second": 0.02,
    "error_radius_growth_tiles_per_minute": 6,
    "stale_after_ticks": 600,
    "drop_below_confidence": 0.05,
    "merge_radius_tiles": 3,
    "merge_window_ticks": 100,
    "agreement_confidence_bonus": 0.3,
    "max_tracks_per_player": 4096,
