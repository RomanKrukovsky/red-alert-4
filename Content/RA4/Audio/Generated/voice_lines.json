      "control_style": "restrained triumph"
    },
    {
      "voice_id": "EVA_Coalition",
      "faction": "Coalition",
      "event": "Resources.Low",
      "variant": 1,
      "text": "Resursy ogranicheny. Koordiniruyte raskhod.",
