    {
      "voice_id": "EVA_Soviet",
      "faction": "Soviet",
      "event": "Game.Start",
      "variant": 1,
      "text": "Vnimanie. HQ fronta k rabote pristupil.",
      "style_prefix": "(calm command announcement) ",
      "control_style": "calm command announcement"
    },
    {
      "voice_id": "EVA_Soviet",
      "faction": "Soviet",
      "event": "Base.UnderAttack",
      "variant": 1,
      "text": "Trevoga. Baza pod ognyom protivnika.",
      "style_prefix": "(urgent command) ",
      "control_style": "urgent command"
    },
    {
      "voice_id": "EVA_Soviet",
      "faction": "Soviet",
      "event": "Unit.Ready",
      "variant": 1,
      "text": "Podrazdelenie gotovo k vydvizheniyu.",
      "style_prefix": "(alert ready) ",
      "control_style": "alert ready"
    },
    {
      "voice_id": "EVA_Soviet",
      "faction": "Soviet",
      "event": "Player.Victory",
      "variant": 1,
      "text": "Operatsiya vypolnena. Victory za nami.",
      "style_prefix": "(restrained triumph) ",
      "control_style": "restrained triumph"
    },
    {
      "voice_id": "EVA_Soviet",
      "faction": "Soviet",
      "event": "Resources.Low",
      "variant": 1,
      "text": "Resursy na iskhode. Sokratite raskhod.",
      "style_prefix": "(measured warning) ",
      "control_style": "measured warning"
    },
    {
      "voice_id": "EVA_Alliance",
      "faction": "Alliance",
      "event": "Game.Start",
      "variant": 1,
      "text": "Komandnaya set aktivirovana. Gotova k rabote.",
      "style_prefix": "(calm command announcement) ",
      "control_style": "calm command announcement"
    },
    {
      "voice_id": "EVA_Alliance",
      "faction": "Alliance",
      "event": "Base.UnderAttack",
      "variant": 1,
      "text": "Trevoga. Nasha baza pod udarom.",
      "style_prefix": "(urgent command) ",
      "control_style": "urgent command"
    },
    {
      "voice_id": "EVA_Alliance",
      "faction": "Alliance",
      "event": "Unit.Ready",
      "variant": 1,
      "text": "Boevaya edinitsa gotova k razvyortyvaniyu.",
      "style_prefix": "(alert ready) ",
      "control_style": "alert ready"
    },
    {
      "voice_id": "EVA_Alliance",
      "faction": "Alliance",
      "event": "Player.Victory",
      "variant": 1,
      "text": "Missiya zavershena. Prevoskhodstvo podtverzhdeno.",
      "style_prefix": "(restrained triumph) ",
      "control_style": "restrained triumph"
    },
    {
      "voice_id": "EVA_Alliance",
      "faction": "Alliance",
      "event": "Resources.Low",
      "variant": 1,
      "text": "Vnimanie. Zapas resursov snizhaetsya.",
      "style_prefix": "(measured warning) ",
      "control_style": "measured warning"
    },
    {
      "voice_id": "EVA_Coalition",
      "faction": "Coalition",
      "event": "Game.Start",
      "variant": 1,
      "text": "Tsentr komandovaniya na svyazi. Operatsiya nachata.",
      "style_prefix": "(calm command announcement) ",
      "control_style": "calm command announcement"
    },
    {
      "voice_id": "EVA_Coalition",
      "faction": "Coalition",
      "event": "Base.UnderAttack",
      "variant": 1,
      "text": "Trevoga. Obekt pod ognyom protivnika.",
      "style_prefix": "(urgent command) ",
      "control_style": "urgent command"
    },
    {
      "voice_id": "EVA_Coalition",
      "faction": "Coalition",
      "event": "Unit.Ready",
      "variant": 1,
      "text": "Podrazdelenie v polnoy gotovnosti.",
      "style_prefix": "(alert ready) ",
      "control_style": "alert ready"
    },
    {
      "voice_id": "EVA_Coalition",
      "faction": "Coalition",
      "event": "Player.Victory",
      "variant": 1,
      "text": "Strategicheskaya tsel dostignuta.",
