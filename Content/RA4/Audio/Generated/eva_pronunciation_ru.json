  "numbers_and_units": {
    "0": "nol",
    "1": "odín",
    "2": "dva",
    "3": "tri",
    "4": "chetýre",
    "5": "pyat",
    "10": "désyat",
    "30": "trídtsat",
    "60": "shestdesyát",
    "100": "sto",
    "25%": "dvádtsat pyat protséntov",
    "50%": "pyatdesyát protséntov",
    "100%": "sto protséntov",
