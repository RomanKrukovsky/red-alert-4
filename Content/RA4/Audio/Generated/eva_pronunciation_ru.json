  "normalization_rules": [
    {
      "pattern": "\\bT([1-3])\\b",
      "replace": "Tir $1"
    },
    {
      "pattern": "\\b([0-9]+)%\\b",
      "replace": "$1 protsentov"
    },
    {
      "pattern": "\\b([0-9]+)s\\b",
      "replace": "$1 sekund"
    },
    {
      "pattern": "\\bMCV\\b",
      "replace": "Em-Si-Vi"
    },
    {
      "pattern": "\\bEMP\\b",
      "replace": "Elektro-magnitnyy impuls"
    }
  ]
