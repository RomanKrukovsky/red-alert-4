  "normalization_rules": [
    {
      "pattern": "\\bT([1-3])\\b",
      "replace": "Тир $1"
    },
    {
      "pattern": "\\b([0-9]+)%\\b",
      "replace": "$1 процентов"
    },
    {
      "pattern": "\\b([0-9]+)s\\b",
      "replace": "$1 секунд"
    },
    {
      "pattern": "\\bMCV\\b",
      "replace": "Эм-Си-Ви"
    },
    {
      "pattern": "\\bEMP\\b",
      "replace": "Электро-магнитный импульс"
    }
  ]
