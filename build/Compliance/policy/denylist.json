{
  "version": "1.0.0",
  "production_roots": [
    "Assets",
    "Binaries",
    "Config",
    "Content",
    "Docs",
    "Source",
    "Tools"
  ],
  "manifest_paths": [
    "Content/AssetRegistry/ThirdPartyAssets.json"
  ],
  "forbidden_directories": [
    "ExternalResearch",
    "Tools/ContentImport/RA3_Mod_Files",
    "Tools/ContentImport/RA3_XML_Source"
  ],
  "forbidden_extensions": [
    ".big",
    ".tga",
    ".w3x",
    ".xml",
    ".xsd"
  ],
  "binary_asset_extensions": [
    ".a",
    ".bin",
    ".bmp",
    ".cur",
    ".dll",
    ".dylib",
    ".exe",
    ".fbx",
    ".gif",
    ".ico",
    ".jpeg",
    ".jpg",
    ".lib",
    ".modules",
    ".mp3",
    ".ogg",
    ".otf",
    ".pak",
    ".png",
    ".psd",
    ".so",
    ".target",
    ".ttf",
    ".uasset",
    ".umap",
    ".wav",
    ".webp",
    ".zip"
  ],
  "identifier_rules": [
    {
      "id": "command_and_conquer_identifier",
      "pattern": "command\\s*(?:&|and)\\s*conquer",
      "description": "Command & Conquer identifier is forbidden in production roots."
    },
    {
      "id": "red_alert_3_identifier",
      "pattern": "\\bred\\s*alert\\s*3\\b|\\bra3\\b",
      "description": "Red Alert 3 / RA3 identifier is forbidden in production roots."
    },
    {
      "id": "electronic_arts_identifier",
      "pattern": "\\belectronic arts\\b|\\beala\\b",
      "description": "Electronic Arts identifier is forbidden in production roots."
    },
    {
      "id": "ea_copyright",
      "pattern": "copyright[^\\n\\r]{0,80}electronic arts",
      "description": "EA copyright text is forbidden in production roots."
    }
  ],
  "xml_policy_rules": [
    {
      "id": "xml_doctype",
      "pattern": "<!DOCTYPE",
      "description": "DTD/DOCTYPE is forbidden in production XML-like files.",
      "extensions": [
        ".xml",
        ".xsd"
      ]
    },
    {
      "id": "xml_entity",
      "pattern": "<!ENTITY",
      "description": "Entity declarations are forbidden in production XML-like files.",
      "extensions": [
        ".xml",
        ".xsd"
      ]
    },
    {
      "id": "xml_external_system",
      "pattern": "SYSTEM\\s+[\"'](?:file|https?|ftp)://",
      "description": "External XML system references are forbidden in production XML-like files.",
      "extensions": [
        ".xml",
        ".xsd"
      ]
    },
    {
      "id": "path_traversal_reference",
      "pattern": "(?:\\.\\./|\\.\\.\\\\)",
      "description": "Path traversal tokens are forbidden in production XML-like files.",
      "extensions": [
        ".xml",
        ".xsd"
      ]
    },
    {
      "id": "absolute_local_path",
      "pattern": "(?:/Users/|/home/|[A-Za-z]:\\\\\\\\)",
      "description": "Absolute local workstation paths are forbidden in production metadata.",
      "extensions": [
        ".json",
        ".ini",
        ".md",
        ".txt",
        ".xml",
        ".xsd",
        ".yaml",
        ".yml"
      ]
    }
  ]
}
