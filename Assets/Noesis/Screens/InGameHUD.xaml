<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="RA4.InGameHUD">

    <Grid>
        <!-- Top Resource Bar -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,20,0">
            <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="15,5" CornerRadius="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <TextBlock Text="{Binding Credits, StringFormat='💰 {0}'}" Foreground="#FFCC00" FontFamily="{StaticResource FontSecondary}" FontSize="18"/>
                    <TextBlock Text="{Binding Power, StringFormat='⚡ {0}'}" Foreground="#00CCFF" FontFamily="{StaticResource FontSecondary}" FontSize="18"/>
                    <TextBlock Text="{Binding Intel, StringFormat='🧠 {0}'}" Foreground="#CC00FF" FontFamily="{StaticResource FontSecondary}" FontSize="18"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Right Production Sidebar -->
        <Border Width="320" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="2,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="240"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Minimap Control -->
                <Border Grid.Row="0" Margin="10" BorderBrush="{StaticResource ThemePrimaryBrush}" BorderThickness="1">
                    <Image Source="{Binding MinimapTexture}"/>
                </Border>

                <!-- Production Category Tabs -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Stretch">
                    <Button Content="СТРОЕНИЯ" Style="{StaticResource RA4ButtonStyle}" FontSize="12" Padding="8,6"/>
                    <Button Content="ПЕХОТА" Style="{StaticResource RA4ButtonStyle}" FontSize="12" Padding="8,6"/>
                    <Button Content="ТЕХНИКА" Style="{StaticResource RA4ButtonStyle}" FontSize="12" Padding="8,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</UserControl>
