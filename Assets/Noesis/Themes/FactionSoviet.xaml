<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Soviet Red / Gold Color Palette -->
    <Color x:Key="ThemePrimaryColor">#FF1A1A</Color>
    <Color x:Key="ThemeSecondaryColor">#FFB700</Color>
    <Color x:Key="ThemePanelBgColor">#D8140A0A</Color>

    <SolidColorBrush x:Key="ThemePrimaryBrush" Color="{StaticResource ThemePrimaryColor}"/>
    <SolidColorBrush x:Key="ThemeSecondaryBrush" Color="{StaticResource ThemeSecondaryColor}"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource ThemePanelBgColor}"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#5A1515"/>

</ResourceDictionary>
